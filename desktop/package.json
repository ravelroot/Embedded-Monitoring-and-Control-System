{
  "name": "malha",
  "productName": "Malha",
  "version": "1.0.0",
  "description": "Painel desktop do sistema embarcado Malha: monitoramento e controle de um ESP32 por USB",
  "main": "dist/main.js",
  "private": true,
  "license": "MIT",
  "author": "ravelroot",
  "homepage": "https://github.com/ravelroot/Embedded-Monitoring-and-Control-System",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --tests && node --test --test-reporter=spec \"out-test/*.test.cjs\"",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --win --x64",
    "dist:portable": "node scripts/build.mjs && electron-builder --win portable --x64",
    "wasm": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "22.20.5",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "preact": "10.29.8",
    "resedit": "3.1.1",
    "typescript": "5.9.3",
    "uplot": "1.6.32"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ravelroot/Embedded-Monitoring-and-Control-System.git"
  }
}
